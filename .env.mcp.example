# MCP credentials for the servers declared in .mcp.json
#
# Copy to .env.mcp (gitignored) and export before starting Claude Code:
#   set -a && source .env.mcp && set +a && claude
#
# Only the two key-based servers below need values. Higgsfield authenticates
# over OAuth in the browser (/mcp -> higgsfield -> Authenticate), and
# Playwright + Chrome DevTools need no credentials at all.

# https://www.perplexity.ai/account/api  -> perplexity_search / ask / research / reason
PERPLEXITY_API_KEY=

# https://www.firecrawl.dev/app/api-keys -> firecrawl_scrape / crawl / search / extract
FIRECRAWL_API_KEY=
